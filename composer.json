{
    "name": "yepr/metagen",
    "description": "Meta-gen: a Joomla component that models modelling languages and generates their forms",
    "type": "joomla-component",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Herman Peeren",
            "email": "herman@yepr.nl",
            "homepage": "https://yepr.nl"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/HermanPeeren/generator-core"
        }
    ],
    "require": {
        "php": ">=8.3",
        "yepr/generator-core": "^0.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Yepr\\Component\\Metagen\\Administrator\\": "src/administrator/components/com_metagen/src/",
            "Yepr\\Component\\Metagen\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "phpcs",
        "cs-fix": "php-cs-fixer fix",
        "cs-fix-dry": "php-cs-fixer fix --dry-run --diff",
        "update-xml": "php build/update-xml.php",
        "build": [
            "@update-xml",
            "php build/build.php"
        ],
        "install-local": [
            "@build",
            "php tools/install-local.php"
        ],
        "cypress": "npx cypress run",
        "seed": "php tools/seed-metalanguage.php"
    },
    "config": {
        "sort-packages": true
    }
}
