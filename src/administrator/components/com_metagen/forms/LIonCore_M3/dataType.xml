<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset
		addruleprefix="Yepr\Component\Metagen\Administrator\Rule"
		addfieldprefix="Yepr\Gen\Joomla\Form\Field"
	>

		<!-- DataType_type: a DataType is either a PrimitiveType or an Enumeration -->
		<field
				name="dataType_type"
				type="radio"
				default="PrimitiveType"
				label="COM_METAGEN_METALANGUAGE_DATATYPE_FIELD_DATATYPE_TYPE_LABEL"
				description="COM_METAGEN_METALANGUAGE_DATATYPE_FIELD_DATATYPE_TYPE_DESC"
		>
			<option value="PrimitiveType">COM_METAGEN_METALANGUAGE_DATATYPE_FIELD_PRIMITIVETYPE_LABEL</option>
			<option value="Enumeration">COM_METAGEN_METALANGUAGE_DATATYPE_FIELD_ENUMERATION_LABEL</option>
		</field>

		<field
				name="primitiveType"
				type="subform"
				formsource="administrator/components/com_metagen/forms/LIonCore_M3/primitiveType.xml"
				label="COM_METAGEN_METALANGUAGE_DATATYPE_FIELD_PRIMITIVETYPE_LABEL"
				id="primitiveType"
				layout="joomla.form.field.subform.default"
				showon="dataType_type:PrimitiveType"
		/>

		<field
				name="enumeration"
				type="subform"
				formsource="administrator/components/com_metagen/forms/LIonCore_M3/enumeration.xml"
				label="COM_METAGEN_METALANGUAGE_DATATYPE_FIELD_ENUMERATION_LABEL"
				id="enumeration"
				layout="joomla.form.field.subform.default"
				showon="dataType_type:Enumeration"
		/>
		<!-- /DataType_type-->

		<field
			name="extends"
			value="LanguageEntity"
			type="hidden"
		/>

		<field
			name="LIonWeb_key"
			value="LanguageEntity.DataType"
			type="hidden"
		/>
	</fieldset>
</form>
