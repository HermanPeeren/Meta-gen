<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset
		addruleprefix="Yepr\Component\Metagen\Administrator\Rule"
		addfieldprefix="Yepr\Gen\Joomla\Form\Field"
	>

		<field
				name="type"
				type="Reference"
				objecttype="Classifier"
				label="COM_METAGEN_METALANGUAGE_LINK_FIELD_TYPE_LABEL"
				id="type"
		/>

		<field
				name="is_multiple"
				type="checkbox"
				label="COM_METAGEN_ATTRIBUTE_FIELD_ISMULTIPLE_LABEL"
				description=""
		/>

		<!-- A Link to another Classifier is either a Containment ("child") or a Reference -->
		<field
				name="link_type"
				type="radio"
				default="property"
				label="COM_METAGEN_LINK_FIELD_CONTAINMENT_OR_REFERENCE_LABEL"
				description="COM_METAGEN_LINK_FIELD_CONTAINMENT_OR_REFERENCE_DESC"
		>
			<option value="Containment">COM_METAGEN_LINK_FIELD_CONTAINMENT</option>
			<option value="Reference">COM_METAGEN_LINK_FIELD_REFERENCE</option>
		</field>

		<field
				name="containment"
				type="subform"
				formsource="administrator/components/com_metagen/forms/LIonCore_M3/containment.xml"
				label="COM_METAGEN_LINK_FIELD_CONTAINMENT_LABEL"
				id="containment"
				layout="joomla.form.field.subform.default"
				showon="link_type:Containment"
		/>

		<field
				name="link"
				type="subform"
				formsource="administrator/components/com_metagen/forms/LIonCore_M3/reference.xml"
				label="COM_METAGEN_LINK_FIELD_REFERENCE_LABEL"
				id="link"
				layout="joomla.form.field.subform.default"
				showon="link_type:Reference"
		/>
		<!-- /feature_type-->

		<!--description="COM_METAGEN_ATTRIBUTE_FIELD_ISMULTIPLE_DESC"-->

		<field
			name="typeReference_key"
			type="hidden"
		/>

		<field
				name="extends"
				value="Feature"
				type="hidden"
		/>

		<field
				name="LIonWeb_key"
				value="Feature.Link"
				type="hidden"
		/>

	</fieldset>
</form>
