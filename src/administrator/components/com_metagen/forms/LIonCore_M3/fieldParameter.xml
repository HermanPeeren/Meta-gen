<?xml version="1.0" encoding="utf-8"?>
<!--
	One attribute a custom field class reads.

	`owner="Entity"` is the example that made this necessary: it tells ER1's
	SlotField which slots to offer, and without it the picker resolves and is
	empty - which reads as "there are no slots" rather than as a mistake.

	A name and a value, because that is all a form attribute is. Anything more
	structured would be this component deciding what a field class somebody else
	wrote is allowed to be configured with.
-->
<form>
	<fieldset
		addfieldprefix="Yepr\Gen\Joomla\Form\Field"
	>
		<field
				name="name"
				type="text"
				label="COM_METAGEN_METALANGUAGE_FIELDPARAMETER_FIELD_NAME_LABEL"
				description="COM_METAGEN_METALANGUAGE_FIELDPARAMETER_FIELD_NAME_DESC"
				size="30"
		/>

		<field
				name="value"
				type="text"
				label="COM_METAGEN_METALANGUAGE_FIELDPARAMETER_FIELD_VALUE_LABEL"
				size="40"
		/>

		<field
				name="LIonWeb_key"
				value="FieldParameter"
				type="hidden"
		/>
	</fieldset>
</form>
