<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset
		addruleprefix="Yepr\Component\Metagen\Administrator\Rule"
		addfieldprefix="Yepr\Gen\Joomla\Form\Field"
	>

		<field
			name="type"
			type="Reference"
				objecttype="DataType"
			label="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_TYPE_LABEL"
			id="type"
			/>

		<field
				name="typeReference_key"
				type="hidden"
		/>

			<!--
				What a new row holds before anybody fills it in.
			
				A fact about the language rather than about the form: a new page
				being a detail page unless somebody says otherwise is part of what
				the language means, and it is the same wherever the language is
				generated to. Presentation went to the generator at 3.5; this did
				not, and the difference is whether another target would want it too.
			
				For an enumeration it is one of the literal keys.
			-->
			<field
				name="default_value"
				type="text"
				label="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_DEFAULT_LABEL"
				description="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_DEFAULT_DESC"
			/>

			<!--
				The field class this property is edited with, when a text box will not do.
			
				Empty for almost everything: the datatype decides the input, and that is
				the arrangement a language should stay in. This is for the cases where a
				component has written a field class that does something no primitive can -
				ER1's Slot picker reads its choices from a catalogue rather than from a
				list in the form.
			
				**This is the one place a language may name a component.** Paths and
				language keys must not, because a package is loaded by more than one; a
				field class genuinely lives in one, and a language using it genuinely
				depends on it. Saying so is better than losing the field or pretending
				the class is somewhere it is not.
			-->
			<field
				name="field_type"
				type="text"
				label="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_FIELDTYPE_LABEL"
				description="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_FIELDTYPE_DESC"
				size="30"
			/>

			<field
				name="field_prefix"
				type="text"
				label="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_FIELDPREFIX_LABEL"
				description="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_FIELDPREFIX_DESC"
				size="50"
				showon="field_type!:"
			/>

			<field
				name="field_parameters"
				type="subform"
				formsource="administrator/components/com_metagen/forms/LIonCore_M3/fieldParameter.xml"
				multiple="true"
				buttons="add,remove,move"
				layout="joomla.form.field.subform.repeatable"
				label="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_FIELDPARAMETERS_LABEL"
				description="COM_METAGEN_METALANGUAGE_PROPERTY_FIELD_FIELDPARAMETERS_DESC"
				id="field_parameters"
				showon="field_type!:"
			/>

		<field
				name="LIonWeb_key"
				value="Feature.Property"
				type="hidden"
		/>

	</fieldset>
</form>
